msgstr ""
"`wit` did not respond within {seconds:.0f}s: it was considered hung and the "
"operation was cancelled."

#: wiibackup_manager/wit_wrapper.py:806
#, python-brace-format
msgid ""
"`wit` no escribió un solo byte en {minutes:.0f} minutos: se lo dio por "
"colgado y se canceló la operación."
msgstr ""
"`wit` did not write a single byte in {minutes:.0f} minutes: it was "
"considered hung and the operation was cancelled."

#: wiibackup_manager/wit_wrapper.py:813
#, python-brace-format
msgid ""
"`wit` lleva más de {hours:.0f} horas sin terminar: se canceló la operación."
msgstr ""
"`wit` has been running for more than {hours:.0f} hours without finishing: "
"the operation was cancelled."

#: wiibackup_manager/wit_wrapper.py:1085 wiibackup_manager/wit_wrapper.py:1170
