#: wiibackup_manager/window.py:3094
#, python-brace-format
msgid "Hay una operación en curso: {ops}."
msgid_plural "Hay operaciones en curso: {ops}."
msgstr[0] "One operation is running: {ops}."
msgstr[1] "These operations are running: {ops}."

#: wiibackup_manager/window.py:3103
#, python-brace-format
msgid ""
"Ojo: «{ops}» no se puede cancelar -corre con permisos de administrador, "
"fuera de la app-. Si cerrás, la ventana desaparece pero eso sigue "
"funcionando hasta terminar. Es mejor esperar."
msgstr ""
"Careful: “{ops}” cannot be cancelled -it runs with administrator "
"permissions, outside the app-. If you close, the window goes away but that "
"keeps running until it finishes. Better to wait."

#: wiibackup_manager/window.py:3112
msgid ""
"En Modo Fábrica el formateo va a seguir como root hasta terminar, pero la "
"unidad quedaría sin montar y sin las carpetas apps, games y wbfs: eso lo "
"hace la app cuando el formateo termina, y si está cerrada no puede."
msgstr ""
"In Factory Mode the formatting will keep running as root until it finishes, "
"but the drive would be left unmounted and without the apps, games and wbfs "
"folders: the app does that when the formatting finishes, and it cannot if it "
"is closed."

#: wiibackup_manager/window.py:3118
msgid ""
"Si cerrás ahora se cancela y puede quedar un archivo a medio escribir en la "
"unidad."
msgstr ""
"If you close now it gets cancelled, and a half-written file may be left on "
"the drive."

#: wiibackup_manager/window.py:3122
msgid "¿Cerrar con una operación en curso?"
msgstr "Close while an operation is running?"

#: wiibackup_manager/window.py:3125
msgid "Seguir esperando"
msgstr "Keep waiting"

#: wiibackup_manager/window.py:3126
msgid "Cancelar operación y cerrar"
msgstr "Cancel the operation and close"

#: wiibackup_manager/window.py:3175
msgid "Cancelando antes de cerrar…"
msgstr "Cancelling before closing…"

