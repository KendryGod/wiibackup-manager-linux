msgstr "Invalid Game ID: {game_id!r} (expected 6 characters A-Z/0-9)"

#: wiibackup_manager/drives.py:204
msgid "La unidad USB fue desconectada durante la operación."
msgstr "The USB drive was disconnected during the operation."

#: wiibackup_manager/drives.py:1365
#, python-brace-format
msgid ""
"{dev} pesa {size:.1f} TiB: Modo Fábrica arma una tabla de particiones MBR, "
"la que leen USB Loader GX y Nintendont, y esa tabla no admite discos de más "
"de 2 TiB. No se tocó el disco."
msgstr ""
"{dev} is {size:.1f} TiB: Factory Mode creates an MBR partition table, the "
"one USB Loader GX and Nintendont read, and that table does not support "
"disks larger than 2 TiB. The disk was not touched."

#: wiibackup_manager/f3_wrapper.py:306
#, python-brace-format
msgid ""
"`f3` no informó nada durante {minutes:.0f} minutos: se lo dio por colgado y "
"se cortó la verificación. La memoria puede estar fallando."
msgstr ""
"`f3` reported nothing for {minutes:.0f} minutes: it was considered hung and "
"the check was stopped. The memory may be failing."

#: wiibackup_manager/f3_wrapper.py:516
#, python-brace-format
msgid ""
"Falta instalar {binaries}. Es parte del paquete `f3` (en Fedora: sudo dnf "
"install f3)."
msgstr ""
"You need to install {binaries}. It is part of the `f3` package (on Fedora: "
"sudo dnf install f3)."

