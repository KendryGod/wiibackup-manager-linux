#: wiibackup_manager/window.py:2713
msgid ""
"Gestor de respaldos de Wii (ISO/WBFS) para Linux, inspirado en Wii Backup "
"Manager de Windows."
msgstr ""
"Wii backup manager (ISO/WBFS) for Linux, inspired by Wii Backup Manager for "
"Windows."

#: wiibackup_manager/window.py:2762
#, python-brace-format
msgid "Hay una operación en curso: {ops}."
msgid_plural "Hay operaciones en curso: {ops}."
msgstr[0] "One operation is running: {ops}."
msgstr[1] "These operations are running: {ops}."

#: wiibackup_manager/window.py:2771
#, python-brace-format
msgid ""
"Ojo: «{ops}» no se puede cancelar -corre con permisos de administrador, "
"fuera de la app-. Si cerrás, la ventana desaparece pero eso sigue "
"funcionando hasta terminar. Es mejor esperar."
msgstr ""
"Careful: “{ops}” cannot be cancelled -it runs with administrator "
"permissions, outside the app-. If you close, the window goes away but that "
"keeps running until it finishes. Better to wait."

#: wiibackup_manager/window.py:2777
msgid ""
"Si cerrás ahora se cancela y puede quedar un archivo a medio escribir en la "
"unidad."
msgstr ""
"If you close now it gets cancelled, and a half-written file may be left on "
"the drive."

#: wiibackup_manager/window.py:2781
msgid "¿Cerrar con una operación en curso?"
msgstr "Close while an operation is running?"

#: wiibackup_manager/window.py:2784
msgid "Seguir esperando"
msgstr "Keep waiting"

#: wiibackup_manager/window.py:2785
msgid "Cancelar operación y cerrar"
msgstr "Cancel the operation and close"

#: wiibackup_manager/wit_wrapper.py:289
#, python-brace-format
msgid ""
"`wit` no respondió en {seconds:.0f}s: se lo dio por colgado y se canceló la "
"operación."
msgstr ""
"`wit` did not respond within {seconds:.0f}s: it was considered hung and the "
"operation was cancelled."

#: wiibackup_manager/wit_wrapper.py:436
#, python-brace-format
msgid ""
"`wit` no escribió un solo byte en {minutes:.0f} minutos: se lo dio por "
"colgado y se canceló la operación."
msgstr ""
"`wit` did not write a single byte in {minutes:.0f} minutes: it was "
"considered hung and the operation was cancelled."

#: wiibackup_manager/wit_wrapper.py:443
#, python-brace-format
msgid ""
"`wit` lleva más de {hours:.0f} horas sin terminar: se canceló la operación."
msgstr ""
"`wit` has been running for more than {hours:.0f} hours without finishing: "
"the operation was cancelled."

#: wiibackup_manager/wit_wrapper.py:609 wiibackup_manager/wit_wrapper.py:671
msgid "Operación cancelada antes de arrancar `wit`."
msgstr "Operation cancelled before starting `wit`."

#: wiibackup_manager/wit_wrapper.py:684 wiibackup_manager/wit_wrapper.py:703
msgid "Operación cancelada por el usuario."
msgstr "Operation cancelled by the user."

