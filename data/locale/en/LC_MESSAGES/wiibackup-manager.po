#: wiibackup_manager/disc_header.py:78
msgid "Game ID inválido: {game_id!r} (se esperaban 6 caracteres A-Z/0-9)"
msgstr "Invalid Game ID: {game_id!r} (expected 6 characters A-Z/0-9)"

#: wiibackup_manager/drives.py:204
msgid "La unidad USB fue desconectada durante la operación."
msgstr "The USB drive was disconnected during the operation."

#: wiibackup_manager/drives.py:322
#, python-brace-format
msgid "'{path}' no es un punto de montaje: no hace falta expulsarlo."
msgstr "'{path}' is not a mount point: there is no need to eject it."

#: wiibackup_manager/drives.py:340 wiibackup_manager/drives.py:355
msgid "Unidad expulsada de forma segura."
msgstr "Drive safely ejected."

#: wiibackup_manager/drives.py:344 wiibackup_manager/drives.py:356
msgid "No se pudo desmontar la unidad."
msgstr "Could not unmount the drive."

#: wiibackup_manager/drives.py:352
#, python-brace-format
msgid "No se pudo expulsar la unidad: {error}"
msgstr "Could not eject the drive: {error}"

#: wiibackup_manager/drives.py:935
#, python-brace-format
msgid ""
"{dev} ya no es un dispositivo removible (o desapareció). Se aborta el "
"formateo por seguridad."
msgstr ""
"{dev} is no longer a removable device (or it disappeared). Formatting is "
"aborted for safety."

#: wiibackup_manager/drives.py:940
#, python-brace-format
msgid ""
"El tamaño de {dev} cambió desde que se confirmó ({before} → {after} bytes). "
"Puede ser otro dispositivo: se aborta el formateo por seguridad."
msgstr ""
"The size of {dev} changed since it was confirmed ({before} → {after} bytes). "
"It may be a different device: formatting is aborted for safety."

#: wiibackup_manager/drives.py:951
#, python-brace-format
msgid ""
"La identidad física de {dev} cambió desde que se confirmó ({before} → "
"{after}). Puede ser otro dispositivo del mismo tamaño reconectado en el "
"mismo puerto: se aborta el formateo por seguridad."
msgstr ""
"The physical identity of {dev} changed since it was confirmed ({before} → "
"{after}). It may be a different device of the same size plugged into the "
"same port: formatting is aborted for safety."

#: wiibackup_manager/drives.py:967
#, python-brace-format
msgid ""
"{dev} tiene una partición montada en {mounts}, que es un punto de montaje "
"del sistema operativo. Se aborta el formateo."
msgstr ""
"{dev} has a partition mounted at {mounts}, which is an operating system "
"mount point. Formatting is aborted."

#: wiibackup_manager/drives.py:1030
#, python-brace-format
msgid "{partition} se formateó pero no se pudo montar después: {error}"
msgstr "{partition} was formatted but could not be mounted afterwards: {error}"

#: wiibackup_manager/drives.py:1033
#, python-brace-format
msgid "{partition} se formateó pero no se pudo montar después."
msgstr "{partition} was formatted but could not be mounted afterwards."

#: wiibackup_manager/drives.py:1046
#, python-brace-format
msgid "No se pudo revisar el punto de montaje {path}: {error}"
msgstr "Could not check the mount point {path}: {error}"

#: wiibackup_manager/drives.py:1051
#, python-brace-format
msgid ""
"La unidad quedó montada en {path}, pero ese montaje pertenece al usuario "
"{owner} (la app corre como {uid}) o no admite escritura. En FAT32 los "
"permisos los fija el montaje: desmontala y volvé a montarla desde el gestor "
"de archivos como tu usuario."
msgstr ""
"The drive was mounted at {path}, but that mount belongs to user {owner} (the "
"app runs as {uid}) or does not allow writing. On FAT32 the permissions are "
"set by the mount: unmount it and mount it again from the file manager as "
"your user."

#: wiibackup_manager/drives.py:1374
#, python-brace-format
msgid ""
"{dev} pesa {size:.1f} TiB: Modo Fábrica arma una tabla de particiones MBR, "
"la que leen USB Loader GX y Nintendont, y esa tabla no admite discos de más "
"de 2 TiB. No se tocó el disco."
msgstr ""
"{dev} is {size:.1f} TiB: Factory Mode creates an MBR partition table, the "
"one USB Loader GX and Nintendont read, and that table does not support disks "
"larger than 2 TiB. The disk was not touched."

#: wiibackup_manager/f3_wrapper.py:306
#, python-brace-format
msgid ""
"`f3` no informó nada durante {minutes:.0f} minutos: se lo dio por colgado y "
"se cortó la verificación. La memoria puede estar fallando."
msgstr ""
"`f3` reported nothing for {minutes:.0f} minutes: it was considered hung and "
"the check was stopped. The memory may be failing."

#: wiibackup_manager/f3_wrapper.py:516
#, python-brace-format
msgid ""
"Falta instalar {binaries}. Es parte del paquete `f3` (en Fedora: sudo dnf "
"install f3)."
msgstr ""
"You need to install {binaries}. It is part of the `f3` package (on Fedora: "
"sudo dnf install f3)."

#: wiibackup_manager/f3_wrapper.py:542
#, python-brace-format
msgid "`f3write` terminó con error: {detail}"
msgstr "`f3write` finished with an error: {detail}"

#: wiibackup_manager/f3_wrapper.py:554
#, python-brace-format
msgid "`f3read` terminó con error: {detail}"
msgstr "`f3read` finished with an error: {detail}"

#: wiibackup_manager/f3_wrapper.py:576
msgid "sin detalle"
msgstr "no details"

#: wiibackup_manager/formatting.py:40
#, python-brace-format
msgid "No se pudo eliminar un respaldo temporal de {size} en {path}."
msgstr "Could not delete a {size} temporary backup at {path}."

#: wiibackup_manager/formatting.py:42
#, python-brace-format
msgid ""
"No se pudieron eliminar {n} respaldos temporales ({size} en total): {paths}."
msgstr "Could not delete {n} temporary backups ({size} in total): {paths}."

